# Порт ва база
PORT=3000
# DB_FILE=data/codelab.db
# Санаи оғози курс барои гурӯҳи намоишӣ (танҳо ҳангоми бори аввал сохтани база)
# COURSE_START=2026-11-28

# Санҷандаи C++: judge0 (тавсия барои дарси воқеӣ) ё local (g++ дар ҳамин сервер)
JUDGE_DRIVER=local
# JUDGE_DRIVER=judge0
# JUDGE0_URL=http://127.0.0.1:2358
# JUDGE0_KEY=            # агар хидмат калид талаб кунад (дар сервер мемонад, ба браузер намеравад)
# JUDGE0_KEY_HEADER=X-Auth-Token   # барои RapidAPI: X-RapidAPI-Key
# JUDGE0_RAPIDAPI_HOST=  # барои RapidAPI: judge0-ce.p.rapidapi.com
# JUDGE0_LANGUAGE_ID=54  # C++ (GCC); бо -std=c++17 компилятсия мешавад
# JUDGE_PARALLEL=2       # чанд санҷиш ҳамзамон
